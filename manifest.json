{
  "manifest_version": 3,
  "name": "Granblue Automation Framework",
  "version": "1.1",
  "description": "Full-height side panel DOM automation tool.",
  "permissions": [
    "tabs", 
    "activeTab", 
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open GBF Framework"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://game.granbluefantasy.jp/*", "*://gbf.game.mbga.jp/*"],
      "js": ["content.js"]
    }
  ]
}